// Jsonic Admin panel — perzistentní data (JSONC)
// Cesta: plugins/Skript/scripts/jsonic/web/data.jsonc (~jsonic/web/data.jsonc)
//
// users.{login}     — účty panelu (pass, name, email, role)
// userIds[]         — seznam loginů (pro počítání / iteraci ve Skriptu)
// tokens.{uuid}     — Bearer token → { user: "login" }
// homes.{id}        — domovy (name, owner, world, x, y, z, public)
// homeIds[]         — pořadí / seznam ID domovů
// players.{nick}    — hráči zaznamenaní při joinu
// playerIds[]       — seznam nicků
// activity[]        — log panelu { text, time }
// cmdlog[]          — historie konzolových příkazů { user, cmd, time }

